{
  "name": "webman-tech/laravel-validation",
  "type": "library",
  "license": "MIT",
  "description": "Webman plugin webman-tech/laravel-validation",
  "require": {
    "php": "^8.3",
    "illuminate/validation": "^13.0",
    "webman-tech/common-utils": "^5.0 || dev-main"
  },
  "_comment": [
    "symfony/translation for autodetct locale"
  ],
  "autoload": {
    "psr-4": {
      "WebmanTech\\LaravelValidation\\": ""
    },
    "files": [
      "helper.php"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "webman-tech/laravel-database": "使用 unique / exists 验证规则时需要（或向容器绑定 Illuminate\\Database\\ConnectionResolverInterface）"
  }
}
